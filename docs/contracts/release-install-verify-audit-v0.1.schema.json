{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/release-install-verify-audit-v0.1.schema.json",
  "title": "AO Forge Release Install Verify Audit v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tag",
    "repository",
    "workflow",
    "release",
    "checks",
    "installed_assets"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.release-install-verify.v0.1"
    },
    "status": {
      "const": "passed"
    },
    "tag": {
      "type": "string",
      "pattern": "^v.+"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": ["name", "path", "ref", "run_id", "run_attempt"],
      "properties": {
        "name": {
          "const": "Release Install Verify"
        },
        "path": {
          "const": ".github/workflows/release-install-verify.yml"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["url", "target_commitish", "published_at"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "target_commitish": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "checksums_verified",
        "linux_archive_extracted",
        "darwin_archive_extracted",
        "windows_archive_extracted",
        "installed_binary_checksum_verification",
        "linux_binary_smoke_test"
      ],
      "properties": {
        "checksums_verified": {
          "const": true
        },
        "linux_archive_extracted": {
          "const": true
        },
        "darwin_archive_extracted": {
          "const": true
        },
        "windows_archive_extracted": {
          "const": true
        },
        "installed_binary_checksum_verification": {
          "const": true
        },
        "linux_binary_smoke_test": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "installed_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256", "size_bytes"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
