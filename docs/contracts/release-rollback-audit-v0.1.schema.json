{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/release-rollback-audit-v0.1.schema.json",
  "title": "AO Forge Release Rollback Audit v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "tag",
    "rollback_action",
    "reason",
    "repository",
    "workflow",
    "release_before",
    "release_after",
    "mutation_comparison",
    "operator_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.release-rollback-audit.v0.1"
    },
    "tag": {
      "type": "string",
      "pattern": "^v.+"
    },
    "rollback_action": {
      "type": "string",
      "enum": ["audit-only", "mark-prerelease", "mark-draft"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": ["name", "path", "ref", "run_id", "run_attempt"],
      "properties": {
        "name": {
          "const": "Release Rollback"
        },
        "path": {
          "const": ".github/workflows/release-rollback.yml"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "release_before": {
      "$ref": "#/$defs/release_summary"
    },
    "release_after": {
      "$ref": "#/$defs/release_summary"
    },
    "mutation_comparison": {
      "type": "object",
      "required": [
        "mutation_relevant_fields_unchanged",
        "checked_fields",
        "before",
        "after"
      ],
      "properties": {
        "mutation_relevant_fields_unchanged": {
          "type": "boolean"
        },
        "checked_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "before": {
          "$ref": "#/$defs/normalized_release"
        },
        "after": {
          "$ref": "#/$defs/normalized_release"
        }
      },
      "additionalProperties": false
    },
    "operator_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "release_summary": {
      "type": "object",
      "required": [
        "tag_name",
        "target_commitish",
        "is_draft",
        "is_prerelease",
        "published_at",
        "url",
        "asset_names"
      ],
      "properties": {
        "tag_name": {
          "type": "string",
          "minLength": 1
        },
        "target_commitish": {
          "type": "string",
          "minLength": 1
        },
        "is_draft": {
          "type": "boolean"
        },
        "is_prerelease": {
          "type": "boolean"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "asset_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "normalized_release": {
      "type": "object",
      "required": [
        "tag_name",
        "target_commitish",
        "is_draft",
        "is_prerelease",
        "published_at",
        "url",
        "assets"
      ],
      "properties": {
        "tag_name": {
          "type": "string",
          "minLength": 1
        },
        "target_commitish": {
          "type": "string",
          "minLength": 1
        },
        "is_draft": {
          "type": "boolean"
        },
        "is_prerelease": {
          "type": "boolean"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalized_asset"
          }
        }
      },
      "additionalProperties": false
    },
    "normalized_asset": {
      "type": "object",
      "required": ["name", "digest", "size", "state"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": ["string", "null"]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
