{
  "schema_version": "ao.forge.release-artifact-inventory.v0.1",
  "release_name": "ao-forge",
  "version_tag_pattern": "v*",
  "checksum_manifest": {
    "path": "dist/checksums.txt",
    "algorithm": "sha256",
    "required": true
  },
  "expected_artifacts": [
    {
      "artifact_id": "ao-forge_linux_amd64",
      "path_template": "dist/ao-forge_Linux_x86_64.tar.gz",
      "platform": "linux-amd64",
      "os": "linux",
      "arch": "amd64",
      "package_format": "tar.gz",
      "required": true,
      "checksum_required": true,
      "provenance": {
        "source": "github.com/uesugitorachiyo/ao-forge",
        "builder": "github-actions",
        "workflow": "release"
      },
      "attestations": [
        "github-artifact-attestation",
        "slsa-provenance",
        "signed-checksum"
      ]
    },
    {
      "artifact_id": "ao-forge_darwin_arm64",
      "path_template": "dist/ao-forge_Darwin_arm64.tar.gz",
      "platform": "darwin-arm64",
      "os": "darwin",
      "arch": "arm64",
      "package_format": "tar.gz",
      "required": true,
      "checksum_required": true,
      "provenance": {
        "source": "github.com/uesugitorachiyo/ao-forge",
        "builder": "github-actions",
        "workflow": "release"
      },
      "attestations": [
        "github-artifact-attestation",
        "slsa-provenance",
        "signed-checksum"
      ]
    },
    {
      "artifact_id": "ao-forge_windows_amd64",
      "path_template": "dist/ao-forge_Windows_x86_64.zip",
      "platform": "windows-amd64",
      "os": "windows",
      "arch": "amd64",
      "package_format": "zip",
      "required": true,
      "checksum_required": true,
      "provenance": {
        "source": "github.com/uesugitorachiyo/ao-forge",
        "builder": "github-actions",
        "workflow": "release"
      },
      "attestations": [
        "github-artifact-attestation",
        "slsa-provenance",
        "signed-checksum"
      ]
    }
  ],
  "required_attestations": [
    "github-artifact-attestation",
    "slsa-provenance",
    "signed-checksum"
  ],
  "release_invariants": [
    "public-release-artifacts-only",
    "no-ad-hoc-local-paths",
    "checksums-match-artifacts",
    "preview-evidence-reviewed-before-publish",
    "rehearsal-evidence-reviewed-before-publish"
  ]
}
