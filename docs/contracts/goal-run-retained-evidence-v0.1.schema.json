{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/goal-run-retained-evidence-v0.1.schema.json",
  "title": "AO Forge GoalRun Retained Evidence v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "goal_id",
    "iteration",
    "phase",
    "summary",
    "retention_policy",
    "retention_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.goal-run-retained-evidence.v0.1"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "iteration": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-(planning|implementation|verification|blocked|backoff|stopped|complete)$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "planning",
        "implementation",
        "verification",
        "blocked",
        "backoff",
        "stopped",
        "complete"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "captured_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "command", "status"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "generated_by": {
            "type": "string",
            "minLength": 1
          },
          "baseline_score": {
            "type": "number"
          },
          "candidate_score": {
            "type": "number"
          },
          "required_improvement_percent": {
            "type": "number"
          },
          "actual_improvement_percent": {
            "type": "number"
          },
          "autonomous_claim": {
            "type": "string",
            "minLength": 1
          },
          "rsi_mode": {
            "type": "string",
            "minLength": 1
          },
          "rsi_capability": {
            "type": "string",
            "minLength": 1
          },
          "operator_mode": {
            "type": "string",
            "minLength": 1
          },
          "claim_levels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["claim", "decision", "status"],
              "properties": {
                "claim": {
                  "type": "string",
                  "enum": [
                    "bounded_governed_rsi",
                    "full_autonomous_self_mutating_rsi"
                  ]
                },
                "decision": {
                  "type": "string",
                  "enum": ["allowed", "denied"]
                },
                "status": {
                  "type": "string",
                  "enum": ["passed", "blocked"]
                }
              },
              "additionalProperties": false
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["claim", "decision", "status"],
                  "properties": {
                    "claim": {
                      "const": "bounded_governed_rsi"
                    },
                    "decision": {
                      "const": "allowed"
                    },
                    "status": {
                      "const": "passed"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["claim", "decision", "status"],
                  "properties": {
                    "claim": {
                      "const": "full_autonomous_self_mutating_rsi"
                    },
                    "decision": {
                      "const": "denied"
                    },
                    "status": {
                      "const": "blocked"
                    }
                  }
                }
              }
            ]
          },
          "mutates_repositories": {
            "type": "boolean"
          },
          "families": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["family", "status", "passed"],
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["label"],
              "properties": {
                "label": {
                  "const": "ao-command-rsi-health"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "status",
                "rsi_mode",
                "rsi_capability",
                "operator_mode",
                "claim_levels",
                "mutates_repositories",
                "families"
              ],
              "properties": {
                "command": {
                  "const": "ao-command rsi health"
                },
                "status": {
                  "const": "passed"
                },
                "rsi_mode": {
                  "const": "governed_fixture_local"
                },
                "rsi_capability": {
                  "const": "demonstrated_local_fixture_loop"
                },
                "operator_mode": {
                  "const": "read_only"
                },
                "mutates_repositories": {
                  "const": false
                },
                "families": {
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "required": ["family", "passed"],
                        "properties": {
                          "family": {
                            "const": "ao-arena"
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": ["family", "passed"],
                        "properties": {
                          "family": {
                            "const": "ao-crucible"
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": ["family", "passed"],
                        "properties": {
                          "family": {
                            "const": "ao-sentinel"
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": ["family", "passed"],
                        "properties": {
                          "family": {
                            "const": "ao-promoter"
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": ["family", "passed"],
                        "properties": {
                          "family": {
                            "const": "ao-foundry"
                          },
                          "passed": {
                            "const": true
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "required": ["label"],
              "properties": {
                "label": {
                  "const": "ao-foundry-rsi-candidate"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "schema_version",
                "status",
                "generated_by",
                "baseline_score",
                "candidate_score",
                "mutates_repositories"
              ],
              "properties": {
                "command": {
                  "const": "foundry pulse run"
                },
                "schema_version": {
                  "const": "ao.foundry.rsi-candidate.v0.1"
                },
                "status": {
                  "const": "ready"
                },
                "generated_by": {
                  "const": "foundry pulse run"
                },
                "baseline_score": {
                  "type": "number"
                },
                "candidate_score": {
                  "type": "number"
                },
                "mutates_repositories": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "required": ["label"],
              "properties": {
                "label": {
                  "const": "ao-foundry-rsi-improvement-gate"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "schema_version",
                "status",
                "baseline_score",
                "candidate_score",
                "required_improvement_percent",
                "actual_improvement_percent",
                "autonomous_claim",
                "mutates_repositories"
              ],
              "properties": {
                "command": {
                  "const": "foundry pulse run"
                },
                "schema_version": {
                  "const": "ao.foundry.rsi-improvement-gate.v0.1"
                },
                "status": {
                  "const": "passed"
                },
                "required_improvement_percent": {
                  "type": "number",
                  "minimum": 5
                },
                "actual_improvement_percent": {
                  "type": "number",
                  "minimum": 5
                },
                "autonomous_claim": {
                  "const": "measured_local_improvement"
                },
                "mutates_repositories": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "required": ["label"],
              "properties": {
                "label": {
                  "const": "ao-foundry-rsi-next-improvement-task"
                }
              }
            },
            "then": {
              "required": [
                "command",
                "schema_version",
                "status",
                "required_improvement_percent",
                "actual_improvement_percent",
                "autonomous_claim",
                "mutates_repositories"
              ],
              "properties": {
                "command": {
                  "const": "foundry pulse run"
                },
                "schema_version": {
                  "const": "ao.foundry.rsi-next-improvement-task.v0.1"
                },
                "status": {
                  "const": "ready"
                },
                "required_improvement_percent": {
                  "type": "number",
                  "minimum": 5
                },
                "actual_improvement_percent": {
                  "type": "number",
                  "minimum": 5
                },
                "autonomous_claim": {
                  "const": "derived_local_next_improvement"
                },
                "mutates_repositories": {
                  "const": false
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "retention_policy": {
      "type": "object",
      "required": [
        "layout",
        "temporary_paths_allowed",
        "minimum_retention_days_after_terminal_phase"
      ],
      "properties": {
        "layout": {
          "const": "docs/evidence/goals/<goal_id>/<YYYYMMDDTHHMMSSZ>-<phase>/"
        },
        "temporary_paths_allowed": {
          "const": false
        },
        "minimum_retention_days_after_terminal_phase": {
          "type": "integer",
          "minimum": 90
        }
      },
      "additionalProperties": false
    },
    "retention_metadata": {
      "type": "object",
      "required": [
        "retained_at",
        "retention_class",
        "retain_while_goal_active",
        "deletion_requires_review",
        "cleanup_change_must_name"
      ],
      "properties": {
        "retained_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention_class": {
          "type": "string",
          "enum": ["loop_evidence", "release_provenance", "promotion_provenance"]
        },
        "retain_while_goal_active": {
          "const": true
        },
        "deletion_requires_review": {
          "const": true
        },
        "cleanup_change_must_name": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "contains": {
            "const": "goal_id"
          },
          "items": {
            "type": "string",
            "enum": ["goal_id", "iteration", "reason"]
          },
          "allOf": [
            {
              "contains": {
                "const": "iteration"
              }
            },
            {
              "contains": {
                "const": "reason"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
