{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/production-promotion-audit-v0.1.schema.json",
  "title": "AO Forge Production Promotion Audit v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "tag",
    "repository",
    "workflow",
    "release",
    "evidence_runs",
    "criteria",
    "failed_criteria",
    "operator_assertions",
    "allowed_status_language",
    "operator_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.production-promotion-audit.v0.1"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "blocked"]
    },
    "tag": {
      "type": "string",
      "pattern": "^v.+"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "required": ["name", "path", "ref", "run_id", "run_attempt"],
      "properties": {
        "name": {
          "const": "Production Promotion"
        },
        "path": {
          "const": ".github/workflows/production-promotion.yml"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["url", "target_commitish", "published_at", "soak_hours", "min_soak_hours"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "target_commitish": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "soak_hours": {
          "type": "number",
          "minimum": 0
        },
        "min_soak_hours": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidence_runs": {
      "type": "object",
      "required": ["release_verify", "release_install_verify", "release_rollback_audit"],
      "properties": {
        "release_verify": {
          "$ref": "#/$defs/evidence_run"
        },
        "release_install_verify": {
          "$ref": "#/$defs/evidence_run"
        },
        "release_rollback_audit": {
          "$ref": "#/$defs/evidence_run"
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "object",
      "required": [
        "release_is_published",
        "release_is_not_prerelease",
        "tag_matches_release",
        "soak_window_met",
        "release_verify_succeeded",
        "release_install_verify_succeeded",
        "install_verify_audit_run_matches",
        "install_verify_audit_tag_matches",
        "install_verify_audit_release_matches",
        "rollback_audit_succeeded",
        "rollback_audit_only",
        "rollback_release_unchanged"
      ],
      "properties": {
        "release_is_published": {
          "type": "boolean"
        },
        "release_is_not_prerelease": {
          "type": "boolean"
        },
        "tag_matches_release": {
          "type": "boolean"
        },
        "soak_window_met": {
          "type": "boolean"
        },
        "release_verify_succeeded": {
          "type": "boolean"
        },
        "release_install_verify_succeeded": {
          "type": "boolean"
        },
        "install_verify_audit_run_matches": {
          "type": "boolean"
        },
        "install_verify_audit_tag_matches": {
          "type": "boolean"
        },
        "install_verify_audit_release_matches": {
          "type": "boolean"
        },
        "rollback_audit_succeeded": {
          "type": "boolean"
        },
        "rollback_audit_only": {
          "type": "boolean"
        },
        "rollback_release_unchanged": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "failed_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "release_is_published",
          "release_is_not_prerelease",
          "tag_matches_release",
          "soak_window_met",
          "release_verify_succeeded",
          "release_install_verify_succeeded",
          "install_verify_audit_run_matches",
          "install_verify_audit_tag_matches",
          "install_verify_audit_release_matches",
          "rollback_audit_succeeded",
          "rollback_audit_only",
          "rollback_release_unchanged"
        ]
      }
    },
    "operator_assertions": {
      "type": "object",
      "required": [
        "default_release_verify_controls",
        "no_known_severity_high_or_critical_blockers"
      ],
      "properties": {
        "default_release_verify_controls": {
          "type": "boolean"
        },
        "no_known_severity_high_or_critical_blockers": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "allowed_status_language": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operator_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "evidence_run": {
      "type": "object",
      "required": ["run_id", "url", "conclusion"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "enum": ["success", "failure", "cancelled", "skipped", "timed_out", "action_required", "neutral"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
