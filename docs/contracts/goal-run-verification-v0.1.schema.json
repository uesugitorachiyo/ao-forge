{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/goal-run-verification-v0.1.schema.json",
  "title": "AO Forge GoalRun Verification v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "goal_id",
    "goal_run",
    "verified_at",
    "phases",
    "security_review",
    "mutates_live_state"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.goal-run-verification.v0.1"
    },
    "goal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "goal_run": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "status", "command", "evidence", "required"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "build",
              "type_or_vet",
              "lint",
              "tests",
              "contract_schema",
              "security_scan",
              "public_readiness"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "command": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "security_review": {
      "type": "object",
      "required": ["status", "scopes_checked", "findings", "recommended_actions"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "manual_required"]
        },
        "scopes_checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "secrets",
              "input_validation",
              "authorization",
              "dependencies",
              "logging",
              "public_artifacts"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "mutates_live_state": {
      "const": false
    }
  },
  "additionalProperties": false
}
