{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/release-evidence-bundle-v0.1.schema.json",
  "title": "AO Forge Release Evidence Bundle v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "repository",
    "tag",
    "head_commit",
    "workflow",
    "release_rehearsal_run_id",
    "signature_policy",
    "artifacts",
    "evidence_files",
    "verification_steps"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.release-evidence-bundle.v0.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^release-evidence-[a-z0-9][a-z0-9._-]*$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+.*$"
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "workflow": {
      "type": "object",
      "required": ["name", "path", "ref", "run_id", "run_attempt"],
      "properties": {
        "name": {
          "const": "Release Publish"
        },
        "path": {
          "const": ".github/workflows/release-publish.yml"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "run_attempt": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "release_rehearsal_run_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "signature_policy": {
      "type": "object",
      "required": ["provider", "subject", "verification"],
      "properties": {
        "provider": {
          "const": "github-artifact-attestation"
        },
        "subject": {
          "const": "release-evidence-bundle.json"
        },
        "verification": {
          "const": "block-release-on-missing-or-mismatched-attestation"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "description", "required"],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
