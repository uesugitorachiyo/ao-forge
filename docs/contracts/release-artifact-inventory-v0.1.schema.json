{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/release-artifact-inventory-v0.1.schema.json",
  "title": "AO Forge Release Artifact Inventory v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "release_name",
    "version_tag_pattern",
    "checksum_manifest",
    "expected_artifacts",
    "required_attestations",
    "release_invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.release-artifact-inventory.v0.1"
    },
    "release_name": {
      "type": "string",
      "minLength": 1
    },
    "version_tag_pattern": {
      "type": "string",
      "minLength": 1
    },
    "checksum_manifest": {
      "type": "object",
      "required": ["path", "algorithm", "required"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "const": "sha256"
        },
        "required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "path_template",
          "platform",
          "os",
          "arch",
          "package_format",
          "required",
          "checksum_required",
          "provenance",
          "attestations"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "path_template": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "os": {
            "type": "string",
            "enum": ["linux", "darwin", "windows"]
          },
          "arch": {
            "type": "string",
            "enum": ["amd64", "arm64"]
          },
          "package_format": {
            "type": "string",
            "enum": ["tar.gz", "zip"]
          },
          "required": {
            "const": true
          },
          "checksum_required": {
            "const": true
          },
          "provenance": {
            "type": "object",
            "required": ["source", "builder", "workflow"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "builder": {
                "type": "string",
                "minLength": 1
              },
              "workflow": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "attestations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "github-artifact-attestation",
                "slsa-provenance",
                "signed-checksum",
                "sbom"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "required_attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "github-artifact-attestation",
          "slsa-provenance",
          "signed-checksum",
          "sbom"
        ]
      }
    },
    "release_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "public-release-artifacts-only",
          "no-ad-hoc-local-paths",
          "checksums-match-artifacts",
          "preview-evidence-reviewed-before-publish",
          "rehearsal-evidence-reviewed-before-publish"
        ]
      }
    }
  },
  "additionalProperties": false
}
