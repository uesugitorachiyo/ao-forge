{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/live-mutation-dry-run-plan-v0.1.schema.json",
  "title": "AO Forge Live Mutation Dry-Run Plan v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "mode",
    "target",
    "covenant_authority",
    "worktree_isolation",
    "verification",
    "pr_lifecycle",
    "rollback_rehearsal",
    "provider_boundary",
    "execution_boundary",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.live-mutation-dry-run-plan.v0.1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^forge-live-mutation-plan-[a-z0-9-]{8,64}$"
    },
    "mode": {
      "const": "dry_run_only"
    },
    "target": {
      "type": "object",
      "required": ["repo", "allowed_path_class", "allowed_paths", "mutation_class"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{2,80}$"
        },
        "allowed_path_class": {
          "enum": ["docs_only", "test_only", "low_risk_code"]
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "mutation_class": {
          "enum": [
            "tiny_documentation_change",
            "docs_only_single_file",
            "docs_only_multi_file",
            "test_only",
            "low_risk_code"
          ]
        }
      },
      "additionalProperties": false
    },
    "covenant_authority": {
      "type": "object",
      "required": [
        "required",
        "status",
        "schema_version",
        "authority_packet",
        "authority_packet_sha256"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "approved_dry_run_fixture"
        },
        "schema_version": {
          "const": "covenant.live-mutation-authority.v1"
        },
        "authority_packet": {
          "$ref": "#/$defs/relative_path"
        },
        "authority_packet_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "worktree_isolation": {
      "type": "object",
      "required": [
        "required",
        "status",
        "branch",
        "isolated_worktree",
        "clean_worktree_required",
        "reuse_existing_worktree"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "planned"
        },
        "branch": {
          "type": "string",
          "pattern": "^codex/[a-z0-9._-]{3,80}$"
        },
        "isolated_worktree": {
          "const": true
        },
        "clean_worktree_required": {
          "const": true
        },
        "reuse_existing_worktree": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["required", "commands", "evidence"],
      "properties": {
        "required": {
          "const": true
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "pr_lifecycle": {
      "type": "object",
      "required": [
        "required",
        "status",
        "one_branch_at_a_time",
        "requires_green_checks",
        "merge_method",
        "delete_branch_after_merge"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "planned"
        },
        "one_branch_at_a_time": {
          "const": true
        },
        "requires_green_checks": {
          "const": true
        },
        "merge_method": {
          "enum": ["rebase", "squash_if_rebase_unavailable"]
        },
        "delete_branch_after_merge": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "rollback_rehearsal": {
      "type": "object",
      "required": [
        "required",
        "status",
        "rollback_plan",
        "rollback_plan_sha256",
        "quarantine_on_failure"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "const": "planned"
        },
        "rollback_plan": {
          "$ref": "#/$defs/relative_path"
        },
        "rollback_plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quarantine_on_failure": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "provider_boundary": {
      "type": "object",
      "required": ["provider_calls_allowed", "requires_exact_digest_approval"],
      "properties": {
        "provider_calls_allowed": {
          "const": false
        },
        "requires_exact_digest_approval": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "execution_boundary": {
      "type": "object",
      "required": [
        "mutates_live_repo",
        "creates_release",
        "pushes_tags",
        "uploads_artifacts",
        "operator_kill_switch_required"
      ],
      "properties": {
        "mutates_live_repo": {
          "const": false
        },
        "creates_release": {
          "const": false
        },
        "pushes_tags": {
          "const": false
        },
        "uploads_artifacts": {
          "const": false
        },
        "operator_kill_switch_required": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "description", "required"],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "mutation_class": {
                "enum": ["tiny_documentation_change", "docs_only_single_file"]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "allowed_paths": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "mutation_class": {
                "const": "docs_only_multi_file"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "allowed_paths": {
                "minItems": 1,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {
              "mutation_class": {
                "const": "low_risk_code"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "allowed_path_class": {
                "const": "low_risk_code"
              },
              "allowed_paths": {
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:[\\\\/]" },
          { "pattern": "^~" },
          { "pattern": "(^|/)\\.\\.(/|$)" },
          { "pattern": "(^|/)(tmp|private|secret|secrets)(/|$)" }
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["label", "path", "sha256"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
