{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uesugitorachiyo/ao-forge/docs/contracts/live-docs-execution-guard-v0.1.schema.json",
  "title": "AO Forge Live Docs Execution Guard v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "safe_to_request",
    "safe_to_execute",
    "allowed_next_action",
    "first_failing_check",
    "blocking_next_actions",
    "maintenance_suggestions",
    "mutation_class_policy",
    "approved_scope",
    "source_hashes",
    "required_evidence",
    "guards",
    "mutates_repositories",
    "executes_work",
    "calls_providers",
    "release_or_publish_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.forge.live-docs-execution-guard.v0.1"
    },
    "status": {
      "enum": ["ready", "blocked", "failed"]
    },
    "safe_to_execute": {
      "type": "boolean"
    },
    "safe_to_request": {
      "type": "boolean"
    },
    "allowed_next_action": {
      "type": "string",
      "minLength": 1
    },
    "first_failing_check": {
      "type": "string"
    },
    "blocking_next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maintenance_suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_scope": {
      "type": "object",
      "required": ["repo", "allowed_path_class", "allowed_paths", "mutation_class", "branch"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{2,80}$"
        },
        "allowed_path_class": {
          "enum": ["docs_only", "test_only", "low_risk_code"]
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "mutation_class": {
          "enum": [
            "tiny_documentation_change",
            "docs_only_single_file",
            "docs_only_multi_file",
            "test_only",
            "low_risk_code"
          ]
        },
        "branch": {
          "type": "string",
          "pattern": "^codex/[a-z0-9._-]{3,80}$"
        }
      },
      "additionalProperties": false
    },
    "mutation_class_policy": {
      "type": "object",
      "required": [
        "current_class",
        "permitted_classes",
        "legacy_aliases",
        "denied_classes",
        "authority_boundary",
        "denial_reason"
      ],
      "properties": {
        "current_class": {
          "enum": [
            "tiny_documentation_change",
            "docs_only_single_file",
            "docs_only_multi_file",
            "docs_config_only",
            "test_only",
            "low_risk_code",
            "multi_repo_low_risk",
            "complex_repo_mutation"
          ]
        },
        "permitted_classes": {
          "type": "array",
          "items": {
            "enum": ["docs_only_single_file", "docs_only_multi_file", "test_only", "low_risk_code"]
          }
        },
        "legacy_aliases": {
          "type": "array",
          "items": {
            "const": "tiny_documentation_change"
          }
        },
        "denied_classes": {
          "type": "array",
          "items": {
            "enum": [
              "docs_config_only",
              "test_only",
              "low_risk_code",
              "multi_repo_low_risk",
              "complex_repo_mutation"
            ]
          }
        },
        "authority_boundary": {
          "enum": ["docs_only_classes_only", "test_only_class_only", "low_risk_code_dry_run_only"]
        },
        "denial_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source_hashes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "required": [
        "dry_run_plan",
        "approval_gate",
        "covenant_ticket",
        "mutation_class",
        "docs_only_allowlist",
        "clean_worktree",
        "rollback_plan",
        "sentinel_no_hold",
        "command_readback"
      ],
      "properties": {
        "dry_run_plan": {
          "enum": ["passed", "blocked", "failed"]
        },
        "approval_gate": {
          "enum": ["passed", "blocked", "failed"]
        },
        "covenant_ticket": {
          "enum": ["passed", "blocked", "failed"]
        },
        "mutation_class": {
          "enum": ["passed", "blocked", "failed"]
        },
        "docs_only_allowlist": {
          "enum": ["passed", "blocked", "failed"]
        },
        "clean_worktree": {
          "enum": ["planned", "passed", "blocked", "failed"]
        },
        "rollback_plan": {
          "enum": ["planned", "passed", "blocked", "failed"]
        },
        "sentinel_no_hold": {
          "enum": ["passed", "blocked", "failed"]
        },
        "command_readback": {
          "enum": ["passed", "blocked", "failed"]
        }
      },
      "additionalProperties": false
    },
    "mutates_repositories": {
      "const": false
    },
    "executes_work": {
      "const": false
    },
    "calls_providers": {
      "const": false
    },
    "release_or_publish_allowed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_request": {
            "const": true
          },
          "first_failing_check": {
            "const": ""
          },
          "blocking_next_actions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["blocked", "failed"]
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_request": {
            "const": false
          },
          "safe_to_execute": {
            "const": false
          },
          "first_failing_check": {
            "minLength": 1
          },
          "blocking_next_actions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          },
          "approved_scope": {
            "properties": {
              "mutation_class": {
                "const": "low_risk_code"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_execute": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          },
          "approved_scope": {
            "properties": {
              "mutation_class": {
                "enum": [
                  "tiny_documentation_change",
                  "docs_only_single_file",
                  "docs_only_multi_file",
                  "test_only"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_execute": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:/"
          },
          {
            "pattern": "(^|/)\\.\\.(?:/|$)"
          },
          {
            "pattern": "^~"
          }
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "required": ["name", "path", "schema_version", "status", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
